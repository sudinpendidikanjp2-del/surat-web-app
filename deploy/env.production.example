# Salin ke .env di folder proyek di server (chmod 600). JANGAN commit file .env.
# Dibaca oleh docker-compose.yml. Daftar lengkap variabel ada di .env.example.

# Alamat publik aplikasi (dipakai QR, tautan pelacakan, alamat balik Google, HSTS).
APP_URL=https://surat.contoh.go.id

# Database internal (tidak dibuka ke luar). Kata sandi acak panjang: openssl rand -base64 36
POSTGRES_USER=surat
POSTGRES_PASSWORD=GANTI-DENGAN-KATA-SANDI-ACAK
POSTGRES_DB=surat

# Kata sandi awal akun bawaan saat database masih kosong. Kosong = dibuat acak dan dicetak sekali di log app.
SEED_PASSWORD=

# Pakai image siap jadi dari GitHub (tanpa build di server). Kunci versi agar pembaruan terjadi saat Anda memilih.
COMPOSE_FILE=docker-compose.yml:docker-compose.image.yml
APP_IMAGE=ghcr.io/sudinpendidikanjp2-del/surat-web-app:2.0.2

# --- Reverse proxy: pilih SATU (lihat docs/deployment.md) ---
# a) Nginx bawaan repo ini (TLS Let's Encrypt, batas laju): aktifkan profil dan isi domain.
# COMPOSE_PROFILES=nginx
# DOMAIN=surat.contoh.go.id
# TLS_DIR=/etc/letsencrypt
# b) Reverse proxy di host (Caddy/Nginx terpasang biasa): biarkan APP_BIND=127.0.0.1, arahkan ke 127.0.0.1:APP_PORT.
# APP_PORT=3000
# c) Reverse proxy berbentuk container (Nginx Proxy Manager, Traefik): tambahkan docker-compose.proxy.yml ke COMPOSE_FILE.
# COMPOSE_FILE=docker-compose.yml:docker-compose.image.yml:docker-compose.proxy.yml
# PROXY_NETWORK=nama-jaringan-proxy
# Klien dapat langsung ke port aplikasi (tanpa proxy)? Isi false agar header IP tidak dipercaya.
# TRUST_PROXY=true

# --- Opsional ---
APP_TZ=Asia/Jakarta
# OCR_ENGINE=auto
# GEMINI_API_KEY=
