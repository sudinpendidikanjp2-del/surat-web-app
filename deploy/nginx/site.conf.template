# Dirender oleh image nginx (envsubst): hanya variabel ${DOMAIN} yang diganti.
# Sebelum sertifikat ada: ikuti langkah "Sertifikat TLS" di docs/deployment.md.

upstream app_upstream {
  server app:3000;
  keepalive 16;
}

server {
  listen 80;
  server_name ${DOMAIN};

  # Tantangan ACME (Let's Encrypt)
  location /.well-known/acme-challenge/ {
    root /var/www/certbot;
  }

  location / {
    return 301 https://$host$request_uri;
  }
}

server {
  listen 443 ssl;
  http2 on;
  server_name ${DOMAIN};

  ssl_certificate     /etc/letsencrypt/live/${DOMAIN}/fullchain.pem;
  ssl_certificate_key /etc/letsencrypt/live/${DOMAIN}/privkey.pem;
  ssl_protocols TLSv1.2 TLSv1.3;
  ssl_prefer_server_ciphers off;
  ssl_session_timeout 1d;
  ssl_session_cache shared:SSL:10m;
  ssl_session_tickets off;

  limit_conn perip 40;
  limit_req zone=general burst=60 nodelay;
  # Waktu tunggu bawaan; lokasi di bawah yang butuh lebih lama menimpanya.
  proxy_read_timeout 120s;
  proxy_send_timeout 120s;

  # CSP bernonce dan header lain dikirim aplikasi; dua baris ini menjamin header ada juga pada galat buatan Nginx.
  add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
  add_header X-Content-Type-Options "nosniff" always;

  location = /api/auth/login {
    limit_req zone=login burst=10 nodelay;
    include /etc/nginx/proxy_params.conf;
  }

  # Pelacakan publik oleh pengirim surat (tanpa login).
  location /api/public/lacak/ {
    limit_req zone=lacak burst=20 nodelay;
    include /etc/nginx/proxy_params.conf;
  }

  # Unggah dan pemulihan cadangan: berkas besar dan proses lama (lihat BACKUP_MAX_MB).
  location /api/cadangan/ {
    client_max_body_size 4g;
    proxy_request_buffering off;
    proxy_read_timeout 900s;
    proxy_send_timeout 900s;
    include /etc/nginx/proxy_params.conf;
  }

  # OCR dan PDF surat keluar (LibreOffice) dapat memakan waktu lebih dari satu menit.
  location ~ ^/api/(ocr|letters-out)/ {
    proxy_read_timeout 300s;
    include /etc/nginx/proxy_params.conf;
  }

  # Aset statis berfingerprint: cache panjang.
  location /_next/static/ {
    include /etc/nginx/proxy_params.conf;
    add_header Cache-Control "public, max-age=31536000, immutable" always;
  }

  location / {
    include /etc/nginx/proxy_params.conf;
  }
}
