# Daftar lengkap variabel lingkungan. Diperiksa saat server menyala (src/server/env.ts): nilai yang salah
# menghentikan server dengan pesan yang jelas.
# Untuk PRODUKSI dengan docker compose pakai deploy/env.production.example (lebih ringkas).
# Untuk pengembangan lokal tidak perlu file ini: jalankan `npm run setup` (membuat .env.local).

# --- Database ---
POSTGRES_USER=surat
POSTGRES_DB=surat
# WAJIB di produksi. Buat: openssl rand -base64 24
POSTGRES_PASSWORD=
# Dipakai saat menjalankan tanpa Docker (npm start). Compose menyusunnya sendiri.
DATABASE_URL=postgres://surat:surat_dev@localhost:5432/surat

# --- Aplikasi ---
# Alamat publik tanpa garis miring akhir. Dipakai untuk QR, tautan pelacakan, dan alamat balik Google, juga
# menentukan HSTS. Kosong: diambil dari header permintaan (hanya cocok untuk pengembangan).
APP_URL=
# true HANYA bila aplikasi di belakang reverse proxy yang menimpa X-Real-IP / menambah X-Forwarded-For dan
# aplikasi tidak dapat dijangkau langsung. Dipakai untuk batas percobaan login, pelacakan, dan catatan kegiatan.
# Bila salah diisi true, penyerang dapat memalsukan alamat IP-nya.
TRUST_PROXY=false
PORT=3000
# APP_PORT ada di bagian Reverse proxy di bawah
STORAGE_DIR=./storage/private
MAX_UPLOAD_MB=15
SESSION_HOURS=12
REMINDER_EVERY_MIN=10
# Zona waktu kantor untuk jadwal cadangan harian.
APP_TZ=Asia/Jakarta
# Cadangan (Admin > Cadangan Data). Di luar STORAGE_DIR agar cadangan tidak ikut tercadangkan.
BACKUP_DIR=./storage/backups
BACKUP_MAX_MB=4096
# Kata sandi awal 7 akun bawaan, hanya dipakai saat database masih kosong.
# Kosong di produksi = dibuat acak dan dicetak sekali di log: docker compose logs app | grep "Akun awal"
SEED_PASSWORD=

# --- OCR (opsional) ---
# auto = Gemini bila GEMINI_API_KEY diisi, selain itu Tesseract. Pilihan lain: tesseract, gemini, remote.
OCR_ENGINE=auto
# Gemini (Google). Foto surat dikirim ke Google. Kosongkan bila tidak ingin memakai layanan luar.
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com
# OCR_TIMEOUT_SEC=120
# OCR_FALLBACK=on               # off = jangan jatuh ke Tesseract bila Gemini atau server model gagal
# OCR_URL=http://gpu-host:10000

# --- Google Drive dan Spreadsheet (opsional) ---
# Kredensial diatur di aplikasi (Admin > Google Drive & Sheets), bukan di sini.
# Alamat di bawah hanya untuk pengujian dengan server tiruan; biarkan tertutup di produksi.
# GOOGLE_OAUTH_URL=https://oauth2.googleapis.com
# GOOGLE_ACCOUNTS_URL=https://accounts.google.com
# GOOGLE_API_URL=https://www.googleapis.com
# GOOGLE_SHEETS_URL=https://sheets.googleapis.com

# --- Reverse proxy ---
# Port di host untuk aplikasi (di dalam container selalu 3000).
# APP_PORT=3000
# 127.0.0.1 = hanya proxy di host ini. 0.0.0.0 = proxy di mesin lain atau container yang memakai IP host.
# APP_BIND=127.0.0.1
# Proxy berbentuk container: pakai docker-compose.proxy.yml dan isi nama jaringan Docker milik proxy.
# PROXY_NETWORK=proxy
