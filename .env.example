# Salin menjadi .env lalu sesuaikan. Server membaca variabel lingkungan langsung.
DATABASE_URL=postgres://surat:surat_dev@localhost:5432/surat
PORT=3000
NODE_ENV=production
# Folder penyimpanan file privat (di luar folder publik)
STORAGE_DIR=./storage/private
MAX_UPLOAD_MB=15
SESSION_HOURS=12
REMINDER_EVERY_MIN=10
# Kata sandi awal akun bawaan saat database masih kosong. Ganti segera setelah masuk.
SEED_PASSWORD=surat12345
